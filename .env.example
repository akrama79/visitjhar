# VisitJhar Environment Configuration Example
# Copy this file to .env.local for local overrides.
# NOTE: The VisitJhar platform runs completely standalone with local datasets.
# No external API keys or secrets are required for standard operation.

# Optional frontend application configuration
VITE_APP_TITLE=VisitJhar — Smart Digital Platform for Eco & Cultural Tourism
VITE_ENABLE_ANALYTICS=false
